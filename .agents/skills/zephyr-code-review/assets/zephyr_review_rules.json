        "kernel/",
        "subsys/logging/",
        "subsys/pm/",
        "drivers/can/"
      ],
      "tags": ["timing", "concurrency", "can"]
    },
    {
      "name": "security",
      "patterns": [
        "modules/mbedtls/",
        "modules/trusted-firmware-m/",
        "subsys/secure_storage/",
        "subsys/mgmt/"
      ],
      "tags": ["security", "keys", "credentials", "dfu"]
    }
  ],
